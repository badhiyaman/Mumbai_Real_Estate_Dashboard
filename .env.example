# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your keys never get committed.

# Supabase > Project Settings > Data API (or "API"): Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase > Project Settings > API Keys: the "publishable" key (older projects call it "anon public")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API Keys: the "secret" key (older projects call it "service_role")
# Keep this private. It is only used on the server and by the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the in-app edit form. Choose anything.
ADMIN_PASSWORD=

# Random string that protects the daily news job. Choose anything long.
CRON_SECRET=
